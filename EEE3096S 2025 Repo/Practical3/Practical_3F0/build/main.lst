 249:Core/Src/main.c **** //TODO: Function signatures you defined previously , implement them here
 250:Core/Src/main.c **** //fixed point implementation
 251:Core/Src/main.c **** 	#define SCALE 1000000 // scaling factor (1.0 in fixed-point)
 252:Core/Src/main.c **** 	uint64_t calculate_mandelbrot_fixed_point_arithmetic(int width, int height, int max_iterations) {
 253:Core/Src/main.c **** 		uint64_t mandelbrot_sum = 0;
 254:Core/Src/main.c **** 
 255:Core/Src/main.c **** 		for (int y = 0; y < height; y++) {
 256:Core/Src/main.c **** 			// y0 = (y / height) * 2.0 - 1.0
 257:Core/Src/main.c **** 			int32_t y0 = ((int64_t)y * (SCALE * 2) / height) - SCALE;
 258:Core/Src/main.c **** 
 259:Core/Src/main.c **** 			for (int x = 0; x < width; x++) {
 260:Core/Src/main.c **** 				// x0 = (x / width) * 3.5 - 2.5
 261:Core/Src/main.c **** 				int32_t x0 = ((int64_t)x * (SCALE * 35 / 10) / width) - (SCALE * 25 / 10);
 262:Core/Src/main.c **** 
 263:Core/Src/main.c **** 				int32_t xi = 0;
 264:Core/Src/main.c **** 				int32_t yi = 0;
 265:Core/Src/main.c **** 				int i = 0;
 266:Core/Src/main.c **** 
 267:Core/Src/main.c **** 				while (i < max_iterations) {
 268:Core/Src/main.c **** 					int64_t xi_sq = ((int64_t)xi * xi) / SCALE;
 269:Core/Src/main.c **** 					int64_t yi_sq = ((int64_t)yi * yi) / SCALE;
 270:Core/Src/main.c **** 
 271:Core/Src/main.c **** 					if (xi_sq + yi_sq <= 4 * SCALE) {
 272:Core/Src/main.c **** 						int32_t temp = (int32_t)(xi_sq - yi_sq + x0);
 273:Core/Src/main.c **** 
 274:Core/Src/main.c **** 						int64_t xy = ((int64_t)xi * yi) / SCALE;
 275:Core/Src/main.c **** 						yi = (int32_t)(2 * xy + y0);
 276:Core/Src/main.c **** 						xi = temp;
 277:Core/Src/main.c **** 
 278:Core/Src/main.c **** 						i++;
 279:Core/Src/main.c **** 					} else {
