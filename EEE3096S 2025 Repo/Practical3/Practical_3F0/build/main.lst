 205:Core/Src/main.c **** 		  start_time = HAL_GetTick();
 206:Core/Src/main.c **** 		  if (!use_tiling) {
 207:Core/Src/main.c **** 		      checksum = calculate_mandelbrot_direct_fixed_point(width, height, MAX_ITER);
 208:Core/Src/main.c **** 		  } else {
 209:Core/Src/main.c **** 		      checksum = 0;
 210:Core/Src/main.c **** 		      uint16_t num_tiles_x = (width  + MAX_TILE - 1) / MAX_TILE;
 211:Core/Src/main.c **** 		      uint16_t num_tiles_y = (height + MAX_TILE - 1) / MAX_TILE;
 212:Core/Src/main.c **** 
 213:Core/Src/main.c **** 		      for (int ty = 0; ty < num_tiles_y; ty++) {
 214:Core/Src/main.c **** 		          for (int tx = 0; tx < num_tiles_x; tx++) {
 215:Core/Src/main.c **** 		              uint16_t tile_w = ((tx+1)*MAX_TILE > width)  ? (width  - tx*MAX_TILE) : MAX_TILE;
 216:Core/Src/main.c **** 		              uint16_t tile_h = ((ty+1)*MAX_TILE > height) ? (height - ty*MAX_TILE) : MAX_TILE;
 217:Core/Src/main.c **** 
 218:Core/Src/main.c **** 		              checksum += calculate_mandelbrot_tile_fixed_point(
 219:Core/Src/main.c **** 		                              tx*MAX_TILE, ty*MAX_TILE,
 220:Core/Src/main.c **** 		                              tile_w, tile_h,
 221:Core/Src/main.c **** 		                              width, height, MAX_ITER);
 222:Core/Src/main.c **** 		          }
 223:Core/Src/main.c **** 		      }
 224:Core/Src/main.c **** 		  }
 225:Core/Src/main.c **** 		  end_time = HAL_GetTick();
 226:Core/Src/main.c **** 		  execution_time = end_time - start_time; // ms
 227:Core/Src/main.c **** 		  cycles = (uint64_t)execution_time * 48000000 / 1000; // 48 MHz clock
 228:Core/Src/main.c **** 		  pixels_s = (uint32_t)((double)(width*height) / (execution_time / 1000.0));
 229:Core/Src/main.c **** 
 230:Core/Src/main.c **** 		  // optional: blink LED as progress indicator
 231:Core/Src/main.c **** 		  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);
 232:Core/Src/main.c **** 		  HAL_Delay(100);
 233:Core/Src/main.c **** 
 234:Core/Src/main.c **** 		  // === RECORD RESULT ===
 235:Core/Src/main.c **** 		  results[result_count].width  = width;
 236:Core/Src/main.c **** 		  results[result_count].height = height;
 237:Core/Src/main.c **** 		  results[result_count].execution_time_ms = execution_time;
 238:Core/Src/main.c **** 		  results[result_count].checksum = checksum;
 239:Core/Src/main.c **** 		  results[result_count].throughput_pixels_per_sec = pixels_s;
 240:Core/Src/main.c **** 		  results[result_count].used_tiling = use_tiling;
 241:Core/Src/main.c **** 		  results[result_count].num_tiles = use_tiling ?
 242:Core/Src/main.c **** 			  ((width + MAX_TILE - 1)/MAX_TILE) * ((height + MAX_TILE - 1)/MAX_TILE) : 1;
 243:Core/Src/main.c **** 
 244:Core/Src/main.c **** 		  result_count++;
 245:Core/Src/main.c **** 	  }
