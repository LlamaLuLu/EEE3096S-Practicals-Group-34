 291:Core/Src/main.c **** 	//floating point implementation
 292:Core/Src/main.c **** 	uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations){
 293:Core/Src/main.c **** 	    uint64_t mandelbrot_sum = 0;
 294:Core/Src/main.c **** 	    //TODO: Complete the function implementation
 295:Core/Src/main.c **** 		for (int y = 0; y < height; ++y) {
 296:Core/Src/main.c **** 			double y0 = ((double)y / (double)height) * 2.0 - 1.0;      // map y -> [-1, +1]
 297:Core/Src/main.c **** 			for (int x = 0; x < width; ++x) {
ARM GAS  C:\Users\haany\AppData\Local\Temp\ccjpHQVG.s 			page 8


 298:Core/Src/main.c **** 				double x0 = ((double)x / (double)width) * 3.5 - 2.5;  // map x -> [-2.5, 1.0]
 299:Core/Src/main.c **** 				double xi = 0.0;
 300:Core/Src/main.c **** 				double yi = 0.0;
 301:Core/Src/main.c **** 				int i = 0;
 302:Core/Src/main.c **** 
 303:Core/Src/main.c **** 				while (i < max_iterations && (xi*xi + yi*yi) <= 4.0) {
 304:Core/Src/main.c **** 					double tmp = xi*xi - yi*yi + x0;
 305:Core/Src/main.c **** 					yi = 2.0 * xi * yi + y0;
 306:Core/Src/main.c **** 					xi = tmp;
 307:Core/Src/main.c **** 					++i;
 308:Core/Src/main.c **** 				}
 309:Core/Src/main.c **** 				mandelbrot_sum += (uint64_t)i;
 310:Core/Src/main.c **** 			}
 311:Core/Src/main.c **** 		}
 312:Core/Src/main.c **** 
 313:Core/Src/main.c **** 	    return mandelbrot_sum;
 314:Core/Src/main.c **** 	}
