 207:Core/Src/main.c **** 
 208:Core/Src/main.c **** 	  // TASK 4: =============================== //
 209:Core/Src/main.c **** 	  for (int i = 0; i < sizeof(test_sizes)/sizeof(test_sizes[0]); i++) {
 210:Core/Src/main.c **** 	      width  = test_sizes[i].width;
 211:Core/Src/main.c **** 	      height = test_sizes[i].height;
 212:Core/Src/main.c **** 
 213:Core/Src/main.c **** 	      bool use_tiling = !can_allocate_image(width, height);
 214:Core/Src/main.c **** 
 215:Core/Src/main.c **** 	      start_cycles = DWT->CYCCNT;
 216:Core/Src/main.c **** 	      if (!use_tiling) {
 217:Core/Src/main.c **** 	          // direct computation if memory is OK
 218:Core/Src/main.c **** 	          checksum = calculate_mandelbrot_direct_fixed_point(width, height, MAX_ITER);
 219:Core/Src/main.c **** 	      } else {
 220:Core/Src/main.c **** 	          // break into tiles
 221:Core/Src/main.c **** 	          checksum = 0;
 222:Core/Src/main.c **** 	          uint16_t num_tiles_x = (width  + MAX_TILE - 1) / MAX_TILE;
 223:Core/Src/main.c **** 	          uint16_t num_tiles_y = (height + MAX_TILE - 1) / MAX_TILE;
 224:Core/Src/main.c **** 
 225:Core/Src/main.c **** 	          for (int ty = 0; ty < num_tiles_y; ty++) {
 226:Core/Src/main.c **** 	              for (int tx = 0; tx < num_tiles_x; tx++) {
 227:Core/Src/main.c **** 	                  uint16_t tile_w = ((tx+1)*MAX_TILE > width)  ? (width  - tx*MAX_TILE) : MAX_TILE
 228:Core/Src/main.c **** 	                  uint16_t tile_h = ((ty+1)*MAX_TILE > height) ? (height - ty*MAX_TILE) : MAX_TILE
 229:Core/Src/main.c **** 
 230:Core/Src/main.c **** 	                  checksum += calculate_mandelbrot_tile_fixed_point(
 231:Core/Src/main.c **** 	                                  tx*MAX_TILE, ty*MAX_TILE,
 232:Core/Src/main.c **** 	                                  tile_w, tile_h,
 233:Core/Src/main.c **** 	                                  width, height, MAX_ITER);
 234:Core/Src/main.c **** 	              }
 235:Core/Src/main.c **** 	          }
 236:Core/Src/main.c **** 	      }
 237:Core/Src/main.c **** 	      elapsed_cycles = DWT->CYCCNT - start_cycles;
 238:Core/Src/main.c **** 	      execution_time = (uint32_t)((double)elapsed_cycles / ((double)SystemCoreClock/1000)); // ms
 239:Core/Src/main.c **** 	      pixels_s = (uint32_t)((double)(width*height) / (execution_time / 1000.0));
 240:Core/Src/main.c **** 
 241:Core/Src/main.c **** 	      // optional: blink LED as progress indicator
 242:Core/Src/main.c **** 	      HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);
 243:Core/Src/main.c **** 	      HAL_Delay(100);
 244:Core/Src/main.c **** 
 245:Core/Src/main.c **** 	      // === RECORD RESULT ===
 246:Core/Src/main.c **** 	      results[result_count].width  = width;
 247:Core/Src/main.c **** 	      results[result_count].height = height;
 248:Core/Src/main.c **** 	      results[result_count].execution_time_ms = execution_time;
 249:Core/Src/main.c **** 	      results[result_count].checksum = checksum;
 250:Core/Src/main.c **** 	      results[result_count].throughput_pixels_per_sec = pixels_s;
 251:Core/Src/main.c **** 	      results[result_count].used_tiling = use_tiling;
 252:Core/Src/main.c **** 	      results[result_count].num_tiles = use_tiling ?
 253:Core/Src/main.c **** 	          ((width + MAX_TILE - 1)/MAX_TILE) * ((height + MAX_TILE - 1)/MAX_TILE) : 1;
 254:Core/Src/main.c **** 
 255:Core/Src/main.c **** 	      result_count++;
 256:Core/Src/main.c **** 	  }
 257:Core/Src/main.c **** 	  while(1); // stop after one sweep
 258:Core/Src/main.c **** 
