1457:Core/Src/main.c **** static void restart_dma_with_wave(uint32_t idx)
1458:Core/Src/main.c **** {
1459:Core/Src/main.c ****     if (idx >= NUM_WAVES) return;
1460:Core/Src/main.c **** 
1461:Core/Src/main.c ****     /* disable TIM2 DMA requests so no new transfers are issued while reconfiguring */
1462:Core/Src/main.c ****     __HAL_TIM_DISABLE_DMA(&htim2, TIM_DMA_CC1);
1463:Core/Src/main.c **** 
1464:Core/Src/main.c ****     /* abort any running DMA transfer (non-blocking interrupt-aware) */
1465:Core/Src/main.c ****     (void) HAL_DMA_Abort_IT(&hdma_tim2_ch1);
1466:Core/Src/main.c **** 
1467:Core/Src/main.c ****     /* wait until DMA state is ready (abort completed) */
1468:Core/Src/main.c ****     while (hdma_tim2_ch1.State != HAL_DMA_STATE_READY) {
1469:Core/Src/main.c ****         /* small spin; should be quick */
1470:Core/Src/main.c ****     }
1471:Core/Src/main.c **** 
1472:Core/Src/main.c ****     /* (re)start DMA from the desired LUT */
1473:Core/Src/main.c ****     if (HAL_DMA_Start_IT(&hdma_tim2_ch1,
1474:Core/Src/main.c ****                          (uint32_t)waveforms[idx],
1475:Core/Src/main.c ****                          DestAddress,
1476:Core/Src/main.c ****                          NS) != HAL_OK) {
1477:Core/Src/main.c ****         Error_Handler();
1478:Core/Src/main.c ****     }
1479:Core/Src/main.c **** 
1480:Core/Src/main.c ****     /* re-enable TIM2 -> DMA requests */
1481:Core/Src/main.c ****     __HAL_TIM_ENABLE_DMA(&htim2, TIM_DMA_CC1);
1482:Core/Src/main.c **** }
