4683:Core/Src/main.c **** /* set_waveform: safely switch DMA source and TIM2 timing for waveform idx */
4684:Core/Src/main.c **** void set_waveform(uint32_t idx)
4685:Core/Src/main.c **** {
4686:Core/Src/main.c ****     if (idx >= NUM_WAVES) return;
4687:Core/Src/main.c **** 
4688:Core/Src/main.c ****     uint32_t new_len = wave_lens[idx];
4689:Core/Src/main.c ****     const uint16_t *new_src = waveforms[idx];
4690:Core/Src/main.c **** 
4691:Core/Src/main.c ****     /* compute new TIM2 ticks */
4692:Core/Src/main.c ****     uint32_t new_ticks = calc_tim2_ticks(new_len);
4693:Core/Src/main.c **** 
4694:Core/Src/main.c ****     /* disable DMA requests from TIM2 so no new requests happen while reconfiguring */
4695:Core/Src/main.c ****     __HAL_TIM_DISABLE_DMA(&htim2, TIM_DMA_CC1);
4696:Core/Src/main.c **** 
4697:Core/Src/main.c ****     /* abort any running DMA transfer */
4698:Core/Src/main.c ****     (void)HAL_DMA_Abort_IT(&hdma_tim2_ch1);
4699:Core/Src/main.c **** 
4700:Core/Src/main.c ****     /* wait until DMA state is ready (abort completed) */
4701:Core/Src/main.c ****     while (hdma_tim2_ch1.State != HAL_DMA_STATE_READY) {
4702:Core/Src/main.c ****         /* small spin — abort should be quick */
4703:Core/Src/main.c ****     }
4704:Core/Src/main.c **** 
