4934:Core/Src/main.c **** 
4935:Core/Src/main.c **** /* EXTI0 interrupt handler: cycles through waveforms on button press */
4936:Core/Src/main.c **** void EXTI0_IRQHandler(void)
4937:Core/Src/main.c **** {
4938:Core/Src/main.c ****     /* debounce: ignore presses within 200 ms */
4939:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
4940:Core/Src/main.c ****     if ((now - last_press_ms) < 200u) {
4941:Core/Src/main.c ****         HAL_GPIO_EXTI_IRQHandler(Button0_Pin); /* clear flag */
4942:Core/Src/main.c ****         return;
4943:Core/Src/main.c ****     }
4944:Core/Src/main.c ****     last_press_ms = now;
4945:Core/Src/main.c **** 
4946:Core/Src/main.c ****     /* determine next waveform index */
4947:Core/Src/main.c ****     uint32_t next = (current_wave + 1u) % NUM_WAVES;
4948:Core/Src/main.c **** 
4949:Core/Src/main.c ****     /* set the new waveform (safe switching handled inside) */
4950:Core/Src/main.c ****     set_waveform(next);
4951:Core/Src/main.c **** 
4952:Core/Src/main.c ****     /* clear EXTI flag */
4953:Core/Src/main.c ****     HAL_GPIO_EXTI_IRQHandler(Button0_Pin);
4954:Core/Src/main.c **** }
4955:Core/Src/main.c **** 
4956:Core/Src/main.c **** /* Error handler ------------------------------------------------------------------*/
4957:Core/Src/main.c **** void Error_Handler(void)
