 502:Core/Src/main.c **** /* set_waveform: safely switch DMA source and TIM2 timing for waveform idx */
 503:Core/Src/main.c **** void set_waveform(uint32_t idx)
 504:Core/Src/main.c **** {
 505:Core/Src/main.c ****     if (idx >= NUM_WAVES) return;
 506:Core/Src/main.c **** 
 507:Core/Src/main.c ****     uint32_t new_len = wave_lens[idx];
 508:Core/Src/main.c ****     const uint16_t *new_src = waveforms[idx];
 509:Core/Src/main.c **** 
 510:Core/Src/main.c ****     /* compute new TIM2 ticks */
 511:Core/Src/main.c ****     uint32_t new_ticks = calc_tim2_ticks(new_len);
 512:Core/Src/main.c ****     if (new_ticks == 0u) new_ticks = 1u; /* sanity */
 513:Core/Src/main.c **** 
 514:Core/Src/main.c ****     /* disable DMA requests from TIM2 while reconfiguring */
 515:Core/Src/main.c ****     __HAL_TIM_DISABLE_DMA(&htim2, TIM_DMA_CC1);
 516:Core/Src/main.c **** 
 517:Core/Src/main.c ****     /* abort any running DMA transfer */
 518:Core/Src/main.c ****     (void)HAL_DMA_Abort_IT(&hdma_tim2_ch1);
 519:Core/Src/main.c **** 
 520:Core/Src/main.c ****     /* wait until DMA state is ready (abort completed) */
 521:Core/Src/main.c ****     while (hdma_tim2_ch1.State != HAL_DMA_STATE_READY) {
 522:Core/Src/main.c ****         /* small spin — abort should be quick */
 523:Core/Src/main.c ****     }
 524:Core/Src/main.c **** 
 525:Core/Src/main.c ****     /* reconfigure TIM2 period */
 526:Core/Src/main.c ****     TIM2_Ticks = new_ticks;
 527:Core/Src/main.c ****     htim2.Init.Period = TIM2_Ticks - 1u;
 528:Core/Src/main.c ****     if (HAL_TIM_Base_Init(&htim2) != HAL_OK) {
 529:Core/Src/main.c ****         Error_Handler();
 530:Core/Src/main.c ****     }
 531:Core/Src/main.c **** 
 532:Core/Src/main.c ****     /* set compare in the middle of the period so OC event occurs reliably */
 533:Core/Src/main.c ****     __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, TIM2_Ticks / 2u);
 534:Core/Src/main.c **** 
 535:Core/Src/main.c ****     /* ensure TIM2 OC is running */
 536:Core/Src/main.c ****     if (HAL_TIM_OC_Start(&htim2, TIM_CHANNEL_1) != HAL_OK) {
 537:Core/Src/main.c ****         Error_Handler();
 538:Core/Src/main.c ****     }
 539:Core/Src/main.c **** 
 540:Core/Src/main.c ****     /* start DMA: memory -> peripheral (TIM3->CCR3), length = new_len */
 541:Core/Src/main.c ****     if (HAL_DMA_Start_IT(&hdma_tim2_ch1,
 542:Core/Src/main.c ****                          (uint32_t)new_src,
 543:Core/Src/main.c ****                          DestAddress,
 544:Core/Src/main.c ****                          new_len) != HAL_OK) {
ARM GAS  /var/folders/d6/h50ndp_j7xj_7552gzkj6_s40000gn/T//ccVJeyYC.s 			page 12


 545:Core/Src/main.c ****         Error_Handler();
 546:Core/Src/main.c ****     }
 547:Core/Src/main.c **** 
 548:Core/Src/main.c ****     /* enable DMA requests from TIM2 CC1 again */
 549:Core/Src/main.c ****     __HAL_TIM_ENABLE_DMA(&htim2, TIM_DMA_CC1);
 550:Core/Src/main.c **** 
 551:Core/Src/main.c ****     /* update current wave index and LCD */
 552:Core/Src/main.c ****     current_wave = idx;
 553:Core/Src/main.c ****     lcd_command(CLEAR);
 554:Core/Src/main.c ****     lcd_command(CURSOR_HOME);
 555:Core/Src/main.c ****     lcd_putstring("Wave: ");
 556:Core/Src/main.c ****     lcd_putstring((char*)wave_names[idx]);
 557:Core/Src/main.c **** }
