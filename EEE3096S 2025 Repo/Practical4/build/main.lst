1687:Core/Src/main.c **** /* EXTI0 interrupt handler: cycles through waveforms on button press */
1688:Core/Src/main.c **** void EXTI0_IRQHandler(void)
1689:Core/Src/main.c **** {
1690:Core/Src/main.c ****     /* debounce: ignore presses within 200 ms */
1691:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
1692:Core/Src/main.c ****     if ((now - last_press_ms) < 200u) {
1693:Core/Src/main.c ****         HAL_GPIO_EXTI_IRQHandler(Button0_Pin); /* clear flag */
1694:Core/Src/main.c ****         return;
1695:Core/Src/main.c ****     }
1696:Core/Src/main.c ****     last_press_ms = now;
1697:Core/Src/main.c **** 
1698:Core/Src/main.c ****     /* compute next index first (so display and DMA match new wave) */
1699:Core/Src/main.c ****     wave_idx = (wave_idx + 1u) % NUM_WAVES;
1700:Core/Src/main.c **** 
1701:Core/Src/main.c ****     /* safely restart DMA with the new LUT */
1702:Core/Src/main.c ****     restart_dma_with_wave(wave_idx);
1703:Core/Src/main.c **** 
1704:Core/Src/main.c ****     /* update LCD to show waveform name */
1705:Core/Src/main.c ****     lcd_command(CLEAR);
1706:Core/Src/main.c ****     lcd_command(CURSOR_HOME);
1707:Core/Src/main.c ****     lcd_putstring((char*)wave_names[wave_idx]);
1708:Core/Src/main.c **** 
ARM GAS  /var/folders/d6/h50ndp_j7xj_7552gzkj6_s40000gn/T//ccvm0DDS.s 			page 36


1709:Core/Src/main.c ****     /* clear EXTI flag */
1710:Core/Src/main.c ****     HAL_GPIO_EXTI_IRQHandler(Button0_Pin);
1711:Core/Src/main.c **** }
