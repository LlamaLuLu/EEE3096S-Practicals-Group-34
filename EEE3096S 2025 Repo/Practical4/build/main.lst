 746:Core/Src/main.c **** 
 747:Core/Src/main.c **** /* EXTI0 interrupt handler: cycles through waveforms on button press */
 748:Core/Src/main.c **** void EXTI0_IRQHandler(void)
 749:Core/Src/main.c **** {
 750:Core/Src/main.c ****     /* debounce: ignore presses within 200 ms */
 751:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
 752:Core/Src/main.c ****     if ((now - last_press_ms) < 200u) {
 753:Core/Src/main.c ****         HAL_GPIO_EXTI_IRQHandler(Button0_Pin); /* clear flag */
 754:Core/Src/main.c ****         return;
 755:Core/Src/main.c ****     }
 756:Core/Src/main.c ****     last_press_ms = now;
 757:Core/Src/main.c **** 
 758:Core/Src/main.c ****     /* determine next waveform index */
 759:Core/Src/main.c ****     uint32_t next = (current_wave + 1u) % NUM_WAVES;
 760:Core/Src/main.c **** 
 761:Core/Src/main.c ****     /* set the new waveform */
 762:Core/Src/main.c ****     set_waveform(next);
 763:Core/Src/main.c **** 
 764:Core/Src/main.c ****     /* clear EXTI flag */
 765:Core/Src/main.c ****     HAL_GPIO_EXTI_IRQHandler(Button0_Pin);
 766:Core/Src/main.c **** }
 767:Core/Src/main.c **** 
